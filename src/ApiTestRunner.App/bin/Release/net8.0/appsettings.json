{
  "WebServer": {
    "Host": "localhost",
    "Port": 5005,
    "AutoLaunchBrowser": true
  },
  "Execution": {
    "TestFiles": [
      "Samples/Environments/**/*.yaml",
      "Samples/Endpoints/**/*.yaml"
    ],
    "MaxConcurrency": 4,
    "HttpTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
